require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods.rb")

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Fix for react-native-vector-icons
use_native_modules!

target 'portal' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    # Hermes is now enabled by default in React Native 0.70+
    :hermes_enabled => true,
    # Disable fabric if you have compatibility issues
    :fabric_enabled => false,
    # Disable new architecture if needed
    :new_arch_enabled => false
  )

  # Explicitly add react-native-vector-icons
  pod 'RNVectorIcons', :path => '../node_modules/react-native-vector-icons'

  # Add font pods for vector icons
  pod 'React-RCTSettings'
  
  post_install do |installer|
    react_native_post_install(
      installer,
      # These are the new parameters for React Native 0.71+
      app_path: "#{Pod::Config.instance.installation_root}/..",
      config: config,
      fabric_enabled: false
    )

    # Fix for vector icons and other common issues
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.0'
        config.build_settings["EXCLUDED_ARCHS[sdk=iphonesimulator*]"] = "arm64"
      end
    end

    # Additional fix for fonts and assets
    installer.pods_project.build_configurations.each do |config|
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
    end
  end
end